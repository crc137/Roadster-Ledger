{
  "manifest_version": 3,
  "name": "Roadster Ledger",
  "short_name": "Roadster Ledger",
  "version": "26.1.0",
  "description": "Shows in which country the Roadster is cheaper than the US base model.",
  "author": "CoonDev",
  "homepage_url": "https://dev.coonlink.com/",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tesla.com/roadster/reserve*","https://www.tesla.com/*/roadster/reserve*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
